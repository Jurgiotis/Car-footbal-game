<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Car Football</title>
  <style>
    body {
      background: #17212b;
      color: white;
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 16px;
    }

    button {
      background: #315a78;
      color: white;
      border: 2px solid white;
      border-radius: 8px;
      padding: 10px 14px;
      margin: 5px;
      font-size: 16px;
      cursor: pointer;
    }

    button:hover { background: #477fa6; }

    canvas {
      width: min(800px, 95vw);
      height: auto;
      background: #278044;
      border: 4px solid white;
      margin-top: 12px;
    }
  </style>
</head>
<body>
  <h1>Car Football</h1>
  <p>Pick a car. Drive with WASD or arrow keys. Hold Space to boost!</p>
  <div id="cars"></div>
  <canvas id="game" width="800" height="500"></canvas>
  <p id="message">Choose a car to start!</p>

  <script>
    const canvas = document.getElementById("game");
    const ctx = canvas.getContext("2d");
    const message = document.getElementById("message");

    const choices = [
      { name: "Racer", color: "#ff5c5c", speed: 230 },
      { name: "Turbo", color: "#55baff", speed: 270 },
      { name: "Drifter", color: "#70df75", speed: 220 },
      { name: "Storm", color: "#ffd447", speed: 290 },
      { name: "Titan", color: "#c27aff", speed: 200 }
    ];

    const keys = {};
    let player, enemy, ball;
    let playerScore = 0;
    let enemyScore = 0;
    let timeLeft = 60;
    let playing = false;
    let lastTime = 0;

    const goalTop = 190;
    const goalBottom = 310;

    choices.forEach((car) => {
      const button = document.createElement("button");
      button.textContent = car.name;
      button.onclick = () => startGame(car);
      document.getElementById("cars").appendChild(button);
    });

    document.addEventListener("keydown", (event) => {
      keys[event.key.toLowerCase()] = true;
      if (event.key.startsWith("Arrow") || event.key === " ") {
        event.preventDefault();
      }
    });

    document.addEventListener("keyup", (event) => {
      keys[event.key.toLowerCase()] = false;
    });

    function resetPositions() {
      player.x = 170;
      player.y = 250;
      enemy.x = 630;
      enemy.y = 250;
      ball.x = 400;
      ball.y = 250;
      ball.vx = 0;
      ball.vy = 0;
    }

    function startGame(car) {
      player = { x: 170, y: 250, color: car.color, speed: car.speed, boost: 100 };
      enemy = { x: 630, y: 250, color: "#ff8c42", speed: 180 };
      ball = { x: 400, y: 250, vx: 0, vy: 0, radius: 12 };
      playerScore = 0;
      enemyScore = 0;
      timeLeft = 60;
      playing = true;
      message.textContent = "Your goal is on the right!";
    }

    function moveCar(car, dx, dy, speed, dt) {
      const length = Math.hypot(dx, dy);
      if (length > 0) {
        car.x += (dx / length) * speed * dt;
        car.y += (dy / length) * speed * dt;
      }

      car.x = Math.max(55, Math.min(745, car.x));
      car.y = Math.max(55, Math.min(445, car.y));
    }

    function hitBall(car) {
      const dx = ball.x - car.x;
      const dy = ball.y - car.y;
      const distance = Math.hypot(dx, dy);
      const touchDistance = 32;

      if (distance < touchDistance) {
        const angle = Math.atan2(dy, dx);
        ball.x = car.x + Math.cos(angle) * touchDistance;
        ball.y = car.y + Math.sin(angle) * touchDistance;
        ball.vx += Math.cos(angle) * 260;
        ball.vy += Math.sin(angle) * 260;
      }
    }

    function update(dt) {
      if (!playing) return;

      timeLeft -= dt;
      if (timeLeft <= 0) {
        timeLeft = 0;
        playing = false;
        message.textContent = `Time up! Final score: ${playerScore} - ${enemyScore}. Pick a car to play again.`;
        return;
      }

      let dx = 0;
      let dy = 0;
      if (keys["d"] || keys["arrowright"]) dx++;
      if (keys["a"] || keys["arrowleft"]) dx--;
      if (keys["s"] || keys["arrowdown"]) dy++;
      if (keys["w"] || keys["arrowup"]) dy--;

      const boosting = keys[" "] && player.boost > 0 && (dx !== 0 || dy !== 0);
      const speed = player.speed * (boosting ? 1.7 : 1);

      moveCar(player, dx, dy, speed, dt);

      if (boosting) {
        player.boost = Math.max(0, player.boost - 38 * dt);
      } else {
        player.boost = Math.min(100, player.boost + 20 * dt);
      }

      // The orange computer car follows the ball.
      const enemyDx = ball.x - enemy.x;
      const enemyDy = ball.y - enemy.y;
      moveCar(enemy, enemyDx, enemyDy, enemy.speed, dt);

      hitBall(player);
      hitBall(enemy);

      ball.x += ball.vx * dt;
      ball.y += ball.vy * dt;
      ball.vx *= Math.pow(0.985, dt * 60);
      ball.vy *= Math.pow(0.985, dt * 60);

      if (ball.y < 52 || ball.y > 448) ball.vy *= -0.8;
      ball.y = Math.max(52, Math.min(448, ball.y));

      if (ball.x < 52) {
        if (ball.y > goalTop && ball.y < goalBottom) {
          enemyScore++;
          resetPositions();
        } else {
          ball.vx = Math.abs(ball.vx) * 0.8;
          ball.x = 52;
        }
      }

      if (ball.x > 748) {
        if (ball.y > goalTop && ball.y < goalBottom) {
          playerScore++;
          resetPositions();
        } else {
          ball.vx = -Math.abs(ball.vx) * 0.8;
          ball.x = 748;
        }
      }
    }

    function drawCar(car) {
      ctx.fillStyle = car.color;
      ctx.fillRect(car.x - 22, car.y - 14, 44, 28);
      ctx.fillStyle = "#222";
      ctx.fillRect(car.x + 5, car.y - 9, 10, 18);
    }

    function draw() {
      ctx.clearRect(0, 0, 800, 500);

      // Field and goals
      ctx.strokeStyle = "white";
      ctx.lineWidth = 3;
      ctx.strokeRect(40, 40, 720, 420);
      ctx.beginPath();
      ctx.moveTo(400, 40);
      ctx.lineTo(400, 460);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(400, 250, 65, 0, Math.PI * 2);
      ctx.stroke();
      ctx.strokeRect(20, goalTop, 22, goalBottom - goalTop);
      ctx.strokeRect(758, goalTop, 22, goalBottom - goalTop);

      if (!player) {
        ctx.fillStyle = "white";
        ctx.font = "28px Arial";
        ctx.fillText("Choose one of the cars above!", 220, 245);
        requestAnimationFrame(draw);
        return;
      }

      drawCar(player);
      drawCar(enemy);

      ctx.fillStyle = "white";
      ctx.beginPath();
      ctx.arc(ball.x, ball.y, ball.radius, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = "white";
      ctx.font = "24px Arial";
      ctx.fillText(`${playerScore} - ${enemyScore}`, 365, 30);
      ctx.font = "18px Arial";
      ctx.fillText(`Time: ${Math.ceil(timeLeft)}`, 680, 30);

      ctx.fillStyle = "#333";
      ctx.fillRect(40, 475, 150, 15);
      ctx.fillStyle = "#38c9ff";
      ctx.fillRect(40, 475, 150 * player.boost / 100, 15);
      ctx.fillStyle = "white";
      ctx.fillText("BOOST", 200, 489);

      requestAnimationFrame(draw);
    }

    function gameLoop(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.05);
      lastTime = now;
      update(dt);
      requestAnimationFrame(gameLoop);
    }

    requestAnimationFrame(draw);
    requestAnimationFrame(gameLoop);
  </script>
</body>
</html>
